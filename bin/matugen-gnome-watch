#!/usr/bin/env bash
set -euo pipefail

# Session check: systemd user services do not inherit XDG_CURRENT_DESKTOP, so
# detect a live GNOME session by process. Exit quietly when GNOME is not
# running so that enabling this service in another desktop does nothing.
if ! pgrep -x gnome-shell >/dev/null 2>&1; then
  printf '[%s] GNOME session not detected; exiting\n' "$(date --iso-8601=seconds)"
  exit 0
fi

apply_matugen() {
  printf '[%s] running matugen-gnome-apply\n' "$(date --iso-8601=seconds)"
  if "$HOME/.local/bin/matugen-gnome-apply"; then
    printf '[%s] matugen-gnome-apply finished\n' "$(date --iso-8601=seconds)"
  else
    printf '[%s] matugen-gnome-apply failed\n' "$(date --iso-8601=seconds)"
  fi
}

apply_matugen

# React to wallpaper changes and to GNOME's official light/dark toggle
# (org.gnome.desktop.interface color-scheme).
{
  gsettings monitor org.gnome.desktop.background &
  gsettings monitor org.gnome.desktop.interface &
  wait
} | while read -r line; do
  case "$line" in
    *picture-uri*|*picture-uri-dark*)
      printf '[%s] wallpaper changed: %s\n' "$(date --iso-8601=seconds)" "$line"
      sleep 1
      apply_matugen
      ;;
    *color-scheme*)
      printf '[%s] color scheme changed: %s\n' "$(date --iso-8601=seconds)" "$line"
      sleep 1
      apply_matugen
      ;;
  esac
done
