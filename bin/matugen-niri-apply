#!/usr/bin/env bash
set -euo pipefail

# Apply a dark Matugen theme for Niri (wayland compositor).
#
# Wallpaper source: `awww query` (swww renamed to awww) with a fallback to
# `swww query`, then ~/Pictures/Wallpapers. Niri itself does not manage
# wallpapers, so the wallpaper tool running in the session is queried.

STATE_DIR="$HOME/.cache/matugen-niri"
PALETTE_STATE="$STATE_DIR/last-palette.txt"
THEME_STATE="$STATE_DIR/last-theme.txt"
MATUGEN_CONFIG="$HOME/.config/matugen/config.toml"
case "${XDG_STATE_HOME-}" in
  /*) STATE_HOME="$XDG_STATE_HOME" ;;
  *) STATE_HOME="$HOME/.local/state" ;;
esac
LIFECYCLE_LOCK="$STATE_HOME/matugen-theme-sync/niri.lock"
INHERITED_LOCK_FD_ENV="MATUGEN_NIRI_INHERITED_LOCK_FD"

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }

usage() {
  printf 'Usage: %s [startup|wallpaper|scheme|manual] [--force] [--print-wallpaper] [WALLPAPER_PATH]\n' "${0##*/}" >&2
}

trigger="manual"
force=0
print_wallpaper=0
image_arg=""
for argument in "$@"; do
  case "$argument" in
    startup|wallpaper|scheme|manual) trigger="$argument" ;;
    --force) force=1 ;;
    --print-wallpaper) print_wallpaper=1 ;;
    -*) usage; exit 2 ;;
    *) image_arg="$argument" ;;
  esac
done

# ---------------------------------------------------------------------------
# Wallpaper resolution
# ---------------------------------------------------------------------------

query_awww() {
  local output
  command -v awww >/dev/null 2>&1 || return 1
  if ! output="$(awww query --all --json 2>/dev/null)"; then
    return 1
  fi
  printf '%s' "$output" | python3 -c '
import json
import os
import sys

try:
    payload = json.load(sys.stdin)
except (json.JSONDecodeError, TypeError):
    raise SystemExit(1)

if not isinstance(payload, dict):
    raise SystemExit(1)

candidates = []
for namespace in payload.values():
    if not isinstance(namespace, list):
        continue
    for output in namespace:
        if not isinstance(output, dict):
            continue
        displaying = output.get("displaying")
        image = displaying.get("image") if isinstance(displaying, dict) else None
        if not isinstance(image, str) or not os.path.isfile(image):
            continue
        name = output.get("name", "")
        name = name if isinstance(name, str) else ""
        candidates.append((name.casefold(), image, name))

if not candidates:
    raise SystemExit(1)

candidates.sort(key=lambda candidate: (candidate[0], candidate[1]))
_, selected_path, selected_name = candidates[0]
selected_label = selected_name or "<unnamed>"
if len(candidates) > 1:
    print(
        "awww reports multiple valid output wallpapers; selecting output "
        f"{selected_label} ({selected_path}) for the global palette",
        file=sys.stderr,
    )
print(selected_path)
'
}

# `awww query` and older swww versions printed either `image:` or `path:`.
# Keep the rest of the line intact because wallpaper paths may contain spaces.
query_legacy() {
  local tool="$1" output
  command -v "$tool" >/dev/null 2>&1 || return 1
  if ! output="$("$tool" query 2>/dev/null)"; then
    return 1
  fi
  printf '%s' "$output" | python3 -c '
import os
import sys

tool = sys.argv[1]
candidates = []
for line in sys.stdin.read().splitlines():
    positions = [
        (line.rfind(marker), marker)
        for marker in ("image: ", "path: ")
        if marker in line
    ]
    if not positions:
        continue
    index, marker = max(positions)
    path = line[index + len(marker):]
    if not os.path.isfile(path):
        continue
    prefix = line[:index].rstrip()
    name = prefix.split(":", 1)[0].strip()
    candidates.append((name.casefold(), path, name))

if not candidates:
    raise SystemExit(1)

candidates.sort(key=lambda candidate: (candidate[0], candidate[1]))
_, selected_path, selected_name = candidates[0]
selected_label = selected_name or "<unnamed>"
if len(candidates) > 1:
    print(
        f"{tool} reports multiple valid output wallpapers; selecting output "
        f"{selected_label} ({selected_path}) for the global palette",
        file=sys.stderr,
    )
print(selected_path)
' "$tool"
}

query_swww() { query_legacy swww; }

query_wallpaper() {
  query_awww || query_legacy awww || query_swww
}

pick_fallback_wallpaper() {
  find "$HOME/Pictures/Wallpapers" "$HOME/Pictures" -maxdepth 2 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
    2>/dev/null | sort | head -n 1
}

if (( print_wallpaper )); then
  image="$(query_wallpaper)" || exit 1
  printf '%s\n' "$image"
  exit 0
fi

acquire_lifecycle_lock() {
  local inherited_fd="${!INHERITED_LOCK_FD_ENV:-}"
  local inherited_identity lock_identity

  mkdir -p "${LIFECYCLE_LOCK%/*}"
  if [[ "$inherited_fd" =~ ^[0-9]+$ ]] \
    && [[ -e "/proc/$$/fd/$inherited_fd" ]] \
    && [[ -e "$LIFECYCLE_LOCK" ]]; then
    inherited_identity="$(stat -Lc '%d:%i' "/proc/$$/fd/$inherited_fd" 2>/dev/null || true)"
    lock_identity="$(stat -Lc '%d:%i' "$LIFECYCLE_LOCK" 2>/dev/null || true)"
    if [[ -n "$inherited_identity" && "$inherited_identity" == "$lock_identity" ]]; then
      # The CLI passed the same locked open-file description to this one
      # bootstrap child, so this conversion is re-entrant and cannot race.
      flock -x "$inherited_fd"
      return
    fi
  fi

  exec 8>"$LIFECYCLE_LOCK"
  flock -x 8
}

acquire_lifecycle_lock

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/apply.lock"
flock -x 9

if [[ -n "$image_arg" ]]; then
  image="$image_arg"
else
  image="$(query_wallpaper)" || image="$(pick_fallback_wallpaper)" || {
    log "Could not resolve a wallpaper (no arg, awww/swww query failed, no fallback)"
    exit 1
  }
fi

if [[ ! -f "$image" ]]; then
  log "Wallpaper file not found: $image"
  exit 1
fi

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------

input_id="$(sha256sum "$image" | cut -d' ' -f1)"
definition_id="$(sha256sum "$MATUGEN_CONFIG" "$HOME/.config/matugen/templates/"* | sha256sum | cut -d' ' -f1)"
palette_key="$input_id:$definition_id"
theme_key="$palette_key:dark"

palette_current=0
theme_current=0
[[ -f "$PALETTE_STATE" ]] && [[ "$(<"$PALETTE_STATE")" == "$palette_key" ]] && palette_current=1
[[ -f "$THEME_STATE" ]] && [[ "$(<"$THEME_STATE")" == "$theme_key" ]] && theme_current=1

required_outputs=(
  "$HOME/.config/niri/colors.kdl"
  "$HOME/.config/waybar/colors.css"
  "$HOME/.config/rofi/colors.rasi"
  "$HOME/.config/mako/colors"
  "$HOME/.config/gtk-3.0/gtk.css"
  "$HOME/.config/gtk-3.0/colors.css"
  "$HOME/.config/gtk-4.0/gtk.css"
  "$HOME/.config/gtk-4.0/colors.css"
  "$HOME/.config/qt5ct/colors/matugen.conf"
  "$HOME/.config/qt6ct/colors/matugen.conf"
  "$HOME/.config/kitty/themes/Matugen.conf"
  "$HOME/.config/nvim/colors/matugen.vim"
  "$HOME/.config/btop/themes/matugen.theme"
  "$HOME/.config/cava/themes/matugen"
  "$HOME/.config/tmux/generated.conf"
  "$HOME/.config/zellij/themes/matugen.kdl"
  "$HOME/.config/matugen/themes/starship-colors.toml"
  "$HOME/.config/yazi/theme.toml"
  "$HOME/.config/matugen/themes/obsidian.css"
)
for output in "${required_outputs[@]}"; do
  if [[ ! -f "$output" ]]; then
    theme_current=0
  fi
done

if (( ! force && palette_current && theme_current )); then
  log "Wallpaper and dark mode unchanged; skipping theme regeneration"
  exit 0
fi

# ---------------------------------------------------------------------------
# Generate
# ---------------------------------------------------------------------------

if ! command -v matugen >/dev/null 2>&1; then
  log "matugen is not installed (sudo pacman -S matugen)"
  exit 1
fi

log "Generating dark theme from: $image"
# scheme-vibrant gives saturated, distinguishable accent colors for the bar
# and compositor; scheme-fidelity (used on Plasma) produces muted tones that
# look flat in Waybar text.
if ! matugen -c "$MATUGEN_CONFIG" image "$image" --mode dark --source-color-index 0 -t scheme-vibrant; then
  log "matugen failed"
  exit 1
fi

for output in "${required_outputs[@]}"; do
  if [[ ! -f "$output" ]]; then
    log "Expected generated file is missing: $output"
    exit 1
  fi
done

# Live reload of tools that read the generated files. niri/waybar/mako reload
# via their config post_hooks; rofi picks the colors up on its next start.
# Reload applications that read shared templates the same way the other
# desktop scripts do.
reload_kitty() {
  pgrep -x kitty >/dev/null 2>&1 || return 0
  if command -v kitty >/dev/null 2>&1 \
    && kitty +kitten themes --reload-in=all Matugen >/dev/null 2>&1; then
    return 0
  fi
  pkill -SIGUSR1 kitty 2>/dev/null
}

reload_nvim() {
  pgrep -x nvim >/dev/null 2>&1 || return 0
  pkill -SIGUSR1 nvim 2>/dev/null
}

reload_btop() {
  pgrep -x btop >/dev/null 2>&1 || return 0
  pkill -USR2 btop 2>/dev/null
}

reload_cava() {
  pgrep -x cava >/dev/null 2>&1 || return 0
  pkill -USR1 cava 2>/dev/null
}

reload_tmux() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux list-sessions >/dev/null 2>&1 || return 0
  tmux source-file "$HOME/.config/tmux/generated.conf" >/dev/null 2>&1 || \
    log "Could not reload tmux colors"
}

update_starship_palette() {
  local generated="$HOME/.config/matugen/themes/starship-colors.toml"
  local config="$HOME/.config/starship.toml"
  local palette_block palette_name

  [[ -f "$generated" && -f "$config" ]] || return 0
  # Every entry of the generated palette, not just the positional colours:
  # Starship resolves a style's colour name through the active palette, so the
  # names its default styles reference (cyan, purple, red, ...) are part of it.
  palette_block="$(awk '
    /^\[palettes\.[^]]+\]/ { in_palette = 1; print; next }
    in_palette && /^\[/ { exit }
    in_palette && (/^[[:space:]]*#/ || /^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*=/) { print }
  ' "$generated")"
  [[ -n "$palette_block" ]] || return 0
  palette_name="$(awk -F'[][]' '/^\[palettes\./ { sub(/^palettes\./, "", $2); print $2; exit }' "$generated")"
  [[ -n "$palette_name" ]] || return 0

  awk -v new="$palette_block" -v name="$palette_name" '
    BEGIN { in_block = 0; in_palette = 0; in_keys = 1; key_done = 0 }
    # Starship picks the active palette with this top-level key. TOML only
    # accepts it before the first table header, and the managed block sits
    # after other tables, so the key is written in the key section instead.
    in_keys && /^[[:space:]]*palette[[:space:]]*=/ {
      print "palette = \"" name "\""
      key_done = 1
      next
    }
    in_keys && !key_done && /^\[/ {
      print "palette = \"" name "\""
      key_done = 1
      in_keys = 0
    }
    /^# BEGIN MATUGEN PALETTE$/ { in_block = 1; print; next }
    /^# END MATUGEN PALETTE$/ { in_block = 0; print; next }
    in_block && /^\[palettes\.[^]]+\]$/ {
      in_palette = 1
      print new
      next
    }
    in_block && in_palette && /^\[/ { in_palette = 0 }
    in_block && in_palette { next }
    { print }
    END { if (!key_done) print "palette = \"" name "\"" }
  ' "$config" > "$config.tmp"
  mv "$config.tmp" "$config"
}

reload_gtk() {
  command -v gsettings >/dev/null 2>&1 || return 0
  # Re-selecting the theme makes GTK3 notice regenerated colors.css files
  # (mirrors the KDE watcher's apply_gtk_mode). Niri has no GNOME settings
  # daemon, but gsettings is available and writable.
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || return 0
  gsettings set org.gnome.desktop.interface gtk-theme "" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark >/dev/null 2>&1 || true
}

reload_waybar() {
  pgrep -x waybar >/dev/null 2>&1 || return 0
  # SIGUSR2 only reloads waybar's own style.css; the GTK theme stack (menus,
  # tooltips) is initialized once at process start, so a full restart is
  # required for GTK colors to update. setsid detaches from this shell so the
  # restarted bar survives.
  pkill waybar 2>/dev/null || true
  sleep 0.3
  setsid waybar >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

sync_ok=1
if [[ "${MATUGEN_NIRI_NO_RELOAD:-0}" == "1" ]]; then
  # Tests and dry runs must not touch the live session: skip every reload
  # side effect (process restarts, signals, gsettings, palette rewrites).
  log "MATUGEN_NIRI_NO_RELOAD=1; skipping live reloads"
else
  update_starship_palette || sync_ok=0
  reload_gtk || sync_ok=0
  reload_waybar || sync_ok=0
  reload_kitty || sync_ok=0
  reload_nvim || sync_ok=0
  reload_btop || sync_ok=0
  reload_cava || sync_ok=0
  reload_tmux || sync_ok=0
fi

printf '%s\n' "$palette_key" > "$PALETTE_STATE"
if (( sync_ok )); then
  printf '%s\n' "$theme_key" > "$THEME_STATE"
else
  log "Theme generated, but one or more live synchronization steps failed"
  exit 1
fi
log "Applied Matugen dark theme"
